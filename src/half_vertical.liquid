<div class="layout layout--col">
  <div class="flex flex--col w--full gap--medium portrait:gap--small lg:gap--large">
  {% if error %}
    <span class="title title--small lg:title--large">{{ error }}</span>
  {% elsif next %}
    <div class="flex flex--col gap--small lg:gap--medium">
      <span class="label label--underline portrait:label--small lg:label--large">Eerstvolgende</span>
      <span class="value value--large portrait:value--small lg:value--xxlarge">{{ next.type }}</span>
      <span class="label label--small lg:label--large">{{ next.relative }}</span>
    </div>

    <div class="flex flex--col gap--small lg:gap--medium">
      {% for item in by_type %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="title title--small lg:title--base">{{ item.type }}</span>
            <span class="label label--small{% if item.emphasis == 3 %} label--filled{% elsif item.emphasis == 2 %} label--gray{% endif %} lg:label--base">{{ item.relative }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <span class="title title--small lg:title--large">Geen ophaaldag gepland</span>
  {% endif %}
  </div>
</div>

{% render 'title_bar', collector: collector %}
