<div class="layout layout--col">
  <div class="flex flex--col w--full gap--small portrait:gap--xsmall lg:gap--medium">
  {% if error %}
    <span class="title title--small lg:title--base">{{ error }}</span>
  {% elsif next %}
    <span class="label label--underline portrait:label--small lg:label--large">{{ next.relative }}</span>
    <span class="value value--large portrait:value--small lg:value--xlarge lg:portrait:value--large">{{ next.type }}</span>
    <span class="label portrait:label--small lg:label--large">{{ next.weekday }} {{ next.date_label }}</span>
  {% else %}
    <span class="title title--small lg:title--base">Geen ophaaldag</span>
  {% endif %}
  </div>
</div>

{% render 'title_bar', collector: collector %}
