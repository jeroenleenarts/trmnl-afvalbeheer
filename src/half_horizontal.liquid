<div class="layout layout--col gap--medium portrait:gap--small lg:gap--large">
  {% if error %}
    <span class="title title--small lg:title--large">{{ error }}</span>
  {% elsif next %}
    <div class="flex flex--col gap--small lg:gap--medium">
      <span class="label label--underline portrait:label--small lg:label--large">Eerstvolgende</span>
      <span class="value value--xlarge portrait:value--large lg:value--xxlarge">{{ next.type }}</span>
      <span class="label portrait:label--small lg:label--large">{{ next.weekday }} {{ next.date_label }} · {{ next.relative }}</span>
    </div>

    <div class="flex flex--col gap--small lg:gap--medium">
      {% for item in upcoming limit:3 offset:1 %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="title title--small lg:title--base">{{ item.type }}</span>
            <span class="label label--small{% if item.emphasis == 3 %} label--filled{% elsif item.emphasis == 2 %} label--gray{% endif %} lg:label--base">{{ item.weekday }} {{ item.date_label }} · {{ item.relative }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <span class="title title--small lg:title--large">Geen ophaaldag gepland</span>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image image--adaptive" src="data:image/svg+xml;base64,{{ afval_icon | base64_encode }}" alt="">
  <span class="title">Afvalbeheer</span>
  <span class="instance">{{ collector }}</span>
</div>
