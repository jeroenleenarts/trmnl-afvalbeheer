<div class="layout layout--col">
  <div class="flex flex--row stretch-y w--full gap--small portrait:flex--col portrait:gap--xsmall lg:gap--xxlarge lg:portrait:flex--row">
  {% if error %}
    <span class="title title--small lg:title--large">{{ error }}</span>
  {% elsif next %}
    <div class="flex flex--col w--full gap--xsmall lg:gap--small">
      <span class="label label--underline portrait:label--small lg:label--xlarge">Eerstvolgende</span>
      <span class="value value--xlarge portrait:value--large lg:value--mega lg:portrait:value--xxlarge">{{ next.type }}</span>
      <span class="label label--medium lg:label--xlarge">{{ next.weekday }} {{ next.date_label }}</span>
      <span class="label label--medium lg:label--xlarge">{{ next.relative }}</span>
    </div>

    <div class="grid grid--cols-2 portrait:grid--cols-2 gap--large lg:gap--xxlarge">
      {% for item in upcoming limit:4 offset:1 %}
        <div class="flex flex--col gap--xsmall lg:gap--xsmall">
          <span class="title title--large lg:title--xlarge">{{ item.type }}</span>
          <span class="label label--small lg:label--medium">{{ item.relative }}</span>
          <span class="label label--small lg:label--medium">{{ item.weekday }} {{ item.date_label }}</span>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <span class="title title--small lg:title--large">Geen ophaaldag gepland</span>
  {% endif %}
  </div>
</div>

{% render 'title_bar', collector: collector, address: address %}
